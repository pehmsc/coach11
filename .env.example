# ──────────────────────────────────────────────────
# Coach11 — Environment Variables
# Copy this file to .env.local and fill in the values
# ──────────────────────────────────────────────────

# ─── Supabase ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: bypasses RLS. Use the canonical name below.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App URL ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://coach11.app
APP_URL=https://coach11.app

# ─── Auth / Beta Access ──────────────────────────
SUPER_COORDINATOR_EMAIL=admin@example.com

# ─── Web Push (VAPID) ────────────────────────────
NEXT_PUBLIC_ENABLE_WEB_PUSH=true
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:push@coach11.app

# ─── Push Test (optional) ────────────────────────
# PUSH_TEST_SECRET=optional-secret-for-api-push-test

# ─── Sentry ──────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_AUTH_TOKEN=your-auth-token

# ─── PostHog Analytics ───────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Server-side (optional, for feature flags)
# POSTHOG_API_HOST=https://eu.i.posthog.com
# POSTHOG_PROJECT_ID=your-project-id
# POSTHOG_PERSONAL_API_KEY=your-personal-api-key

# ─── Email (Resend) ─────────────────────────────
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@coach11.app

# ─── Google Maps / Places ────────────────────────
# GOOGLE_MAPS_API_KEY=your-google-maps-key
# GOOGLE_PLACES_API_KEY=your-google-places-key

# ─── Location Provider (OSM fallback) ────────────
# OSM_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ─── Public Share Encryption ─────────────────────
PUBLIC_SHARE_TOKEN_ENCRYPTION_KEY=your-encryption-key

# ─── CSP Report-Only (optional) ──────────────────
# CSP_REPORT_ONLY_SUPABASE_URL=
# CSP_REPORT_ONLY_IMG_ORIGINS=
# CSP_REPORT_ONLY_CONNECT_ORIGINS=
# CSP_REPORT_ONLY_REPORT_URI=

# ─── Cron / Maintenance Secrets ──────────────────
# CRON_SECRET=your-cron-secret
# NOTIFICATIONS_MAINTENANCE_SECRET=your-maintenance-secret
# NOTIFICATIONS_PRUNE_SECRET=your-prune-secret
# NOTIFICATIONS_TTL_DAYS=90
# NOTIFICATIONS_PRUNE_MAX_RATIO=0.5
# NOTIFICATIONS_PRUNE_GUARD_MIN_TOTAL=100
